        },
        {
          "field": "own_vs_norm",
          "op": "<",
          "threshold": 0.1
        },
        {
          "field": "overlap_vs_norm",
          "op": "<",
          "threshold": 0.1
        },
        {
          "field": "geo_factor",
          "op": ">",
          "threshold": 0.8
        },
        {
          "field": "unseen_share",
          "op": "<",
          "threshold": 0.05
        }
