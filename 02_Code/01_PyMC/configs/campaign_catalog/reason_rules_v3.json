{
  "contract_name": "campaign_reason_rules",
  "version": "campaign_reasons_v3_20261105",
  "description": "Справочник причин цифры кампании в каталоге прошлых кампаний. Каждая сборка каталога (14_weekly_joint_campaign_reasons.py) размечает кампании по этим правилам. Причина показывается, только если она говорит что-то про саму кампанию: потери на насыщении или от другой рекламы заметно выше или ниже обычного для её основного канала (с одним фактом из журнала размещений, который это объясняет), заметно другая отдача её городов и недель, деньги вне модели или эффект, досчитанный прогнозом после конца данных. Тексты короткие, доли видны на полосе. Нечего сказать: причин нет, карточка показывает только полосу. Правило срабатывает, когда выполнены все его условия; порядок: ранг, внутри ранга самые весомые; до трёх причин. Обычно: медиана по кампаниям той же сборки с тем же основным каналом (по всем кампаниям, если таких меньше min_group). Доли: kept_share досталось кампании, own_loss_share съело своё насыщение, overlap_loss_share съела другая реклама; *_vs_norm разница с обычным. Факты журнала: top_geo_share доля бюджета в самом крупном месте, density_ratio денег на место в неделю (для национальных каналов в неделю) к обычному, burn_2w_share наибольшая доля бюджета за две недели подряд, weeks_n недель от первой до последней, neighbor_rub деньги кампании того же направления и канала, которая больше всех шла в те же недели и места. Менять формулировки и пороги только новой версией файла.",
  "max_reasons": 3,
  "norms": {
    "group_by": "main_channel",
    "statistic": "median",
    "min_group": 5
  },
  "channel_phrases": {
    "Цифровая реклама": "в цифровой рекламе",
    "Наружная реклама": "в наружной рекламе",
    "Indoor": "в Indoor",
    "Радио": "на радио",
    "Национальное ТВ": "на национальном ТВ",
    "Региональное ТВ": "на региональном ТВ"
  },
  "notes": {
    "own_note": {
      "max_items": 1,
      "style": "clause",
      "items": [
        {
          "conditions": [
            {
              "field": "main_nationwide",
              "op": "<",
              "threshold": 0.5
            },
            {
              "field": "top_geo_share",
              "op": ">=",
              "threshold": 0.9995
            }
          ],
          "text": "весь бюджет в одном месте ({top_geo})"
        },
        {
          "conditions": [
            {
              "field": "main_nationwide",
              "op": "<",
              "threshold": 0.5
            },
            {
              "field": "main_digital",
              "op": "<",
              "threshold": 0.5
            },
            {
              "field": "density_ratio",
              "op": ">=",
              "threshold": 3.0
            }
          ],
          "text": "денег на город в неделю в {dense_x} больше обычного"
        },
        {
          "conditions": [
            {
              "field": "main_nationwide",
              "op": ">=",
              "threshold": 0.5
            },
            {
              "field": "density_ratio",
              "op": ">=",
              "threshold": 3.0
            }
          ],
          "text": "денег в неделю в {dense_x} больше обычного"
        },
        {
          "conditions": [
            {
              "field": "main_nationwide",
              "op": "<",
              "threshold": 0.5
            },
            {
              "field": "top_geo_share",
              "op": ">=",
              "threshold": 0.5
            },
            {
              "field": "top_geo_share",
              "op": "<",
              "threshold": 0.9995
            }
          ],
          "text": "{top_geo_pct} бюджета в одном месте ({top_geo})"
        },
        {
          "conditions": [
            {
              "field": "weeks_n",
              "op": ">=",
              "threshold": 4
            },
            {
              "field": "burn_2w_share",
              "op": ">=",
              "threshold": 0.6
            }
          ],
          "text": "{burn_pct} бюджета за две недели"
        }
      ]
    },
    "overlap_note": {
      "max_items": 1,
      "style": "clause",
      "items": [
        {
          "conditions": [
            {
              "field": "neighbor_rub",
              "op": ">",
              "threshold": 0
            }
          ],
          "text": "больше всего «{neighbor_name}» ({neighbor_mln} млн ₽)"
        }
      ]
    }
  },
  "rules": [
    {
      "code": "low_loss",
      "rank": 1,
      "conditions": [
