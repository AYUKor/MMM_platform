{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmm-platform.local/contracts/campaign_catalog_v1.schema.json",
  "title": "CampaignCatalogV1",
  "description": "Past-campaign catalog of the active model package, served exactly as the package extension campaign_catalog_v1 holds it. The portal never recomputes the numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "record_origin",
    "status",
    "title",
    "display_text",
    "package_id",
    "model_version",
    "model_display_name",
    "artifact_id",
    "catalog_version",
    "period_start",
    "period_end",
    "roas_level_label",
    "summary",
    "download",
    "notes",
    "campaigns",
    "updated_at_utc"
  ],
  "properties": {
    "contract_name": {"const": "campaign_catalog_v1"},
    "schema_version": {"const": "1.1.0"},
    "record_origin": {
      "enum": [
        "verified_model_package_artifact",
        "model_package_artifact_unavailable"
      ]
    },
    "status": {"enum": ["available", "unavailable"]},
    "title": {"const": "Прошлые кампании"},
    "display_text": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "pattern": "^pkg_[A-Za-z0-9._-]{8,128}$"},
    "model_version": {"type": ["string", "null"], "minLength": 1},
    "model_display_name": {"type": ["string", "null"], "minLength": 1},
    "artifact_id": {"type": ["string", "null"], "pattern": "^artifact_[0-9a-f]{24}$"},
    "catalog_version": {"type": ["string", "null"], "minLength": 1},
    "period_start": {"type": ["string", "null"], "format": "date"},
    "period_end": {"type": ["string", "null"], "format": "date"},
    "roas_level_label": {"type": ["string", "null"], "minLength": 1},
    "summary": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/summary"}
      ]
    },
    "download": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/download"}
      ]
    },
    "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
    "campaigns": {"type": "array", "items": {"$ref": "#/$defs/campaign"}},
    "updated_at_utc": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaigns_n",
        "computed_n",
        "reliable_n",
        "up_to_120_days_n",
        "longer_120_days_n",
        "budget_rub",
        "computed_budget_rub",
        "turnover_increment_rub",
        "weighted_roas"
      ],
      "properties": {
        "campaigns_n": {"type": "integer", "minimum": 0},
        "computed_n": {"type": "integer", "minimum": 0},
        "reliable_n": {"type": "integer", "minimum": 0},
        "up_to_120_days_n": {"type": "integer", "minimum": 0},
        "longer_120_days_n": {"type": "integer", "minimum": 0},
        "budget_rub": {"type": "number", "minimum": 0},
        "computed_budget_rub": {"type": "number", "minimum": 0},
        "turnover_increment_rub": {"type": "number"},
        "weighted_roas": {"type": ["number", "null"]}
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "size_bytes", "sha256", "download_path", "sheets"],
      "properties": {
        "file_name": {"type": "string", "pattern": "^[^/\\\\]{1,200}\\.xlsx$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "download_path": {"const": "/api/v1/campaign-catalog/download"},
        "sheets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "display_text"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "display_text": {"type": "string", "minLength": 1}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "low", "high"],
      "properties": {
        "estimate": {"type": "number"},
        "low": {"type": "number"},
        "high": {"type": "number"}
      }
    },
    "optionalRange": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/range"}
      ]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "display_name", "budget_rub", "nationwide"],
      "properties": {
        "channel_id": {
          "enum": ["Digital_Performance", "OOH_Total", "Indoor", "Радио", "Нац_ТВ", "Рег_ТВ"]
        },
        "display_name": {
          "enum": ["Цифровая реклама", "Наружная реклама", "Indoor", "Радио", "Национальное ТВ", "Региональное ТВ"]
        },
        "budget_rub": {"type": "number", "minimum": 0},
        "nationwide": {"type": "boolean"}
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "directions",
        "start_date",
        "end_date",
        "days_n",
        "duration_group",
        "budget_rub",
        "channels",
        "main_channel_id",
        "cities",
        "nationwide_channels",
        "status",
        "status_display_text",
        "turnover_increment_rub",
        "orders_per_1000_buyers",
        "avg_basket_increment_rub",
        "roas",
        "overlaps_n",
        "reliable",
        "explanation"
      ],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "directions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ТС5/Онлайн", "ТС5/Оффлайн", "ТСХ/Онлайн", "ТСХ/Оффлайн"]}
        },
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "days_n": {"type": "integer", "minimum": 1},
        "duration_group": {"enum": ["up_to_120_days", "120_days_and_longer"]},
        "budget_rub": {"type": "number", "minimum": 0},
        "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/channel"}},
        "main_channel_id": {
          "enum": ["Digital_Performance", "OOH_Total", "Indoor", "Радио", "Нац_ТВ", "Рег_ТВ"]
        },
        "cities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "nationwide_channels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["computed", "not_computed"]},
        "status_display_text": {"type": ["string", "null"], "minLength": 1},
        "turnover_increment_rub": {"$ref": "#/$defs/optionalRange"},
        "orders_per_1000_buyers": {"$ref": "#/$defs/optionalRange"},
        "avg_basket_increment_rub": {"$ref": "#/$defs/optionalRange"},
        "roas": {"$ref": "#/$defs/optionalRange"},
        "overlaps_n": {"type": "integer", "minimum": 0},
        "reliable": {"enum": [0, 1]},
        "explanation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/explanation"}]}
      }
    },
    "explanation": {
      "type": "object",
      "description": "Why the campaign got its number: the first-ruble potential split into kept effect, loss to the campaign's own saturation and loss to other ads in the same weeks and cities, plus up to three reasons from the versioned rule file, only when something specific to the campaign can be said (none otherwise: the card shows the split only). Explains the catalog numbers, never changes them.",
      "additionalProperties": false,
      "required": [
        "rules_version",
        "potential_turnover_rub",
        "kept_share",
        "own_saturation_share",
        "overlap_share",
        "first_ruble_roas",
        "typical_first_ruble_roas",
        "unseen_budget_share",
        "tail_share",
        "own_saturation_cities",
        "overlap_cities",
        "reasons"
      ],
      "properties": {
        "rules_version": {"type": "string", "minLength": 1},
        "potential_turnover_rub": {"type": "number", "minimum": 0},
        "kept_share": {"type": "number", "minimum": 0, "maximum": 1},
        "own_saturation_share": {"type": "number", "minimum": 0, "maximum": 1},
        "overlap_share": {"type": "number", "minimum": 0, "maximum": 1},
        "first_ruble_roas": {"type": "number", "minimum": 0},
        "typical_first_ruble_roas": {"type": "number", "minimum": 0},
        "unseen_budget_share": {"type": "number", "minimum": 0, "maximum": 1},
        "tail_share": {"type": "number", "minimum": 0, "maximum": 1},
        "own_saturation_cities": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "overlap_cities": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reasons": {"type": "array", "minItems": 0, "maxItems": 3, "items": {"$ref": "#/$defs/note"}}
      }
    }
  }
}
